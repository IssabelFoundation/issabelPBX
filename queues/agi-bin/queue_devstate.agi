#!/usr/bin/php -q
<?php

require_once 'phpagi.php';

/*
 * Usage:
 *
 * AGI(queue_devstate.agi,getqueues|getall|toggle-pause-all[,user])
 *
 * Queue and AstDB state is read through dialplan functions evaluated on the
 * current channel.  Do not add an AMI connection here: this AGI runs in the
 * call path for queue login/logout and must not wait on the manager socket.
 */

$agi = new AGI();
$action = isset($argv[1]) ? strtolower(trim($argv[1])) : '';
$user = isset($argv[2]) ? trim($argv[2]) : '';

switch ($action) {
case 'getqueues':
    get_queue_state($user, channel_var('QUEUENO'));
    break;

case 'getall':
    get_all_queue_state($user);
    break;

case 'toggle-pause-all':
    toggle_pause_all($user);
    break;

default:
    debug("Unknown action '$action'");
    break;
}

exit(0);

function get_queue_state($user, $queue)
{
    global $agi;

    $member = configured_member($queue, $user);
    $tech = $member === null ? 'Local' : $member['tech'];
    $interface = member_interface($user, $tech);
    $logged_in = queue_has_interface($queue, $interface);

    /*
     * QUEUE_MEMBER_LIST() does not expose whether a member is static or
     * dynamic.  A matching interface is therefore reported as logged in.
     * RemoveQueueMember's RQMSTATUS must be used by the dialplan if static
     * members need a distinct user-facing result.
     */
    $status = $logged_in ? 'LOGGEDIN' : 'LOGGEDOUT';

    debug("Agent $user is $status in queue $queue as $interface");
    $agi->set_variable('QUEUESTAT', $status);
    $agi->set_variable('MEMBERTECH', $tech);
}

function get_all_queue_state($user)
{
    global $agi;

    $assigned = assigned_queues($user);
    if (empty($assigned)) {
        debug("No configured queues for agent $user");
        $agi->set_variable('QUEUESTAT', 'NOQUEUES');
        $agi->set_variable('USERQUEUES', '');
        return;
    }

    $logged_in = false;
    $queue_specs = array();
    foreach ($assigned as $queue => $tech) {
        $interface = member_interface($user, $tech);
        if (queue_has_interface($queue, $interface)) {
            $logged_in = true;
        }
        $queue_specs[] = $queue . '~' . $tech;
    }

    $status = $logged_in ? 'LOGGEDIN' : 'LOGGEDOUT';
    debug("Agent $user is $status in configured queues");
    $agi->set_variable('QUEUESTAT', $status);
    $agi->set_variable('USERQUEUES', implode('-', $queue_specs));
}

function toggle_pause_all($user)
{
    global $agi;

    $memberships = current_memberships($user);
    $paused = false;

    foreach ($memberships as $queue => $interface) {
        $paused = $paused || dialplan_function(
            "QUEUE_MEMBER($queue,paused,$interface)"
        ) === '1';
    }

    $new_state = $paused ? '0' : '1';
    foreach ($memberships as $queue => $interface) {
        $agi->set_variable("QUEUE_MEMBER($queue,paused,$interface)", $new_state);
        debug("QUEUE_MEMBER($queue,paused,$interface)=$new_state");
    }

    $agi->set_variable('TOGGLEPAUSED', $new_state);
}

function assigned_queues($user)
{
    $assigned = array();

    foreach (db_keys('QPENALTY') as $queue) {
        $member = configured_member($queue, $user);
        if ($member !== null) {
            $assigned[$queue] = $member['tech'];
        }
    }

    ksort($assigned, SORT_NATURAL);
    return $assigned;
}

function current_memberships($user)
{
    $memberships = array();

    foreach (db_keys('QPENALTY') as $queue) {
        $member = configured_member($queue, $user);
        $tech = $member === null ? 'Local' : $member['tech'];
        $interface = member_interface($user, $tech);
        if (queue_has_interface($queue, $interface)) {
            $memberships[$queue] = $interface;
        }
    }

    return $memberships;
}

function configured_member($queue, $user)
{
    foreach (db_keys("QPENALTY/$queue/agents") as $key) {
        $member = decode_member_key($key);
        if ($member['extension'] === $user) {
            return $member;
        }
    }

    return null;
}

function decode_member_key($key)
{
    $prefixes = array(
        'A' => 'AGENT',
        'S' => 'SIP',
        'P' => 'PJSIP',
        'X' => 'IAX2',
        'Z' => 'ZAP',
        'D' => 'DAHDI',
    );

    $prefix = substr($key, 0, 1);
    if (isset($prefixes[$prefix])) {
        return array(
            'extension' => substr($key, 1),
            'tech' => $prefixes[$prefix],
        );
    }

    return array('extension' => $key, 'tech' => 'Local');
}

function member_interface($user, $tech)
{
    if ($tech === 'Local') {
        return "Local/$user@from-queue/n";
    }

    return "$tech/$user";
}

function queue_has_interface($queue, $interface)
{
    $wanted = normalize_interface($interface);
    foreach (csv_values(dialplan_function("QUEUE_MEMBER_LIST($queue)")) as $member) {
        if (normalize_interface($member) === $wanted) {
            return true;
        }
    }

    return false;
}

function normalize_interface($interface)
{
    $interface = strtolower(trim($interface));

    // Asterisk may omit Local's /n modifier when returning a member list.
    if (substr($interface, 0, 6) === 'local/' && substr($interface, -2) === '/n') {
        $interface = substr($interface, 0, -2);
    }

    return $interface;
}

function db_keys($prefix)
{
    return csv_values(dialplan_function("DB_KEYS($prefix)"));
}

function csv_values($value)
{
    if ($value === '') {
        return array();
    }

    $values = array_map('trim', explode(',', $value));
    return array_values(array_filter($values, 'strlen'));
}

function dialplan_function($function)
{
    global $agi;

    $expression = '${' . $function . '}';
    if (method_exists($agi, 'get_full_variable')) {
        $response = $agi->get_full_variable($expression);
    } else {
        // Older phpagi releases still ask Asterisk to resolve dialplan funcs
        // through GET VARIABLE when the function name is supplied directly.
        $response = $agi->get_variable($function);
    }

    if (isset($response['result']) && (int) $response['result'] === 1) {
        return isset($response['data']) ? trim($response['data']) : '';
    }

    debug("Unable to evaluate $function");
    return '';
}

function channel_var($name)
{
    global $agi;

    $response = $agi->get_variable($name);
    if (isset($response['result']) && (int) $response['result'] === 1) {
        return isset($response['data']) ? trim($response['data']) : '';
    }

    return '';
}

function debug($message, $level = 3)
{
    global $agi;
    $agi->verbose($message, $level);
}
